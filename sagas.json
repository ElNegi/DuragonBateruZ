import { useNavigate } from 'react-router-dom';import races from '../../data/races.json';
export function RaceSelectionScreen(){const nav=useNavigate();return <main className="screen"><div className="screen-head"><div><span className="eyebrow">NUEVA EXPEDICIÓN</span><h2>Elige tu linaje</h2></div></div><div className="race-grid">{races.map(r=><button key={r.id} className={`race-card race-${r.id.toLowerCase()}`} onClick={()=>{localStorage.setItem('ecos-race',r.id);nav('/map')}}><div className="race-sigil">{r.id==='SAIYAN'?'S':r.id==='NAMEK'?'N':'F'}</div><h3>{r.name}</h3><p>{r.identity}</p><span>Seleccionar →</span></button>)}</div></main>}
