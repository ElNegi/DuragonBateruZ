import { useMemo } from 'react';import { useNavigate } from 'react-router-dom';import { generateMap } from '../../roguelike/MapGenerator';
export function MapScreen(){const nodes=useMemo(()=>generateMap(21),[]);const nav=useNavigate();return <main className="screen map-screen"><div className="screen-head"><div><span className="eyebrow">SAGA I · LLEGADA DE LOS SAIYAN</span><h2>Ruta de la expedición</h2></div></div><div className="map-board">{Array.from({length:8},(_,f)=><div className="map-floor" key={f}>{nodes.filter(n=>n.floor===f).map(n=><button key={n.id} className={`map-node n-${n.type.toLowerCase()}`} onClick={()=>n.type==='COMBATE'||n.type==='ELITE'||n.type==='JEFE'?nav('/battle'):nav('/event')}><span>{n.type.slice(0,2)}</span><small>{n.type}</small></button>)}</div>)}</div></main>}
