import { useState } from 'react';import { createRoom,joinRoom } from '../../firebase/firestoreService';import { auth } from '../../firebase/firebase';
export function MultiplayerScreen(){const [room,setRoom]=useState('');const [msg,setMsg]=useState('');async function create(){if(!auth.currentUser)return setMsg('Necesitas una sesión Firebase activa.');try{const c=await createRoom(auth.currentUser.uid);setRoom(c);setMsg(`Sala ${c} creada.`)}catch(e:any){console.error(e);setMsg('No se pudo crear la sala. Revisa Firestore y las reglas.')}}async function join(){if(!auth.currentUser)return;try{await joinRoom(room.toUpperCase(),auth.currentUser.uid);setMsg(`Te uniste a ${room.toUpperCase()}.`)}catch(e:any){console.error(e);setMsg('No se pudo unir a la sala.')}}return <main className="screen center"><section className="event-panel"><span className="eyebrow">MULTIJUGADOR</span><h2>Sala sincronizada</h2><button onClick={create}>Crear sala</button><div className="inline"><input value={room} maxLength={6} onChange={e=>setRoom(e.target.value)} placeholder="ABC123"/><button onClick={join}>Unirse</button></div><p>{msg}</p></section></main>}
